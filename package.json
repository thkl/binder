{
  "name": "binder",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "pnpm --parallel --filter @binder/api --filter @binder/client --filter @binder/worker run dev",
    "start:worker": "pnpm --filter @binder/worker start",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "start:debug": "pnpm -r --workspace-concurrency=1 --if-present run start:debug"

  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
