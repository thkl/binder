{
  "name": "binder",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "pnpm --parallel --filter @binder/api --filter @binder/client --filter @binder/worker run dev",
    "start:worker": "pnpm --filter @binder/worker start",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"packages/*/src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "check:client-a11y": "node scripts/check-client-a11y.mjs",
    "check:client-colors": "node scripts/check-client-colors.mjs",
    "check:settings-i18n": "node scripts/check-settings-i18n.mjs",
    "test": "pnpm -r --if-present run test",
    "coverage": "pnpm -r --if-present run coverage",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "start:debug": "pnpm -r --workspace-concurrency=1 --if-present run start:debug",
    "start:client": "pnpm --filter @binder/client start",
    "checkupdates": "npx npm-check-updates --target minor --removeRange",
    "doupdates": "npx npm-check-updates --target minor --removeRange -u"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
