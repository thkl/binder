{
  "name": "@binder/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/shared/guards/csrf.guard.spec.js dist/features/authentication/guards/authentication.guard.spec.js dist/features/authentication/service/gravatar.spec.js dist/features/document/service/document-storage.service.spec.js dist/shared/util/encryption.service.spec.js dist/shared/http/content-disposition.spec.js dist/database/service/database.migrator.spec.js dist/features/pipeline/service/pipeline.service.spec.js dist/features/plugin/service/plugin-registry.service.spec.js dist/features/calendar/service/calendar.service.spec.js dist/features/metadata/service/vocabulary-precedence.spec.js",
    "coverage": "pnpm build && node --experimental-test-coverage --test dist/shared/guards/csrf.guard.spec.js dist/features/authentication/guards/authentication.guard.spec.js dist/features/document/service/document-storage.service.spec.js dist/shared/util/encryption.service.spec.js dist/shared/http/content-disposition.spec.js dist/database/service/database.migrator.spec.js dist/features/pipeline/service/pipeline.service.spec.js dist/features/plugin/service/plugin-registry.service.spec.js",
    "dev": "dotenv run -f ../../.env -- node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:debug": "dotenv run -f ../../.env -- nest start --debug --watch"
  },
  "dependencies": {
    "@binder/common": "workspace:*",
    "@modelcontextprotocol/server": "2.3.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/sequelize": "12.0.0",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/throttler": "6.7.1",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "mupdf": "1.28.1",
    "nest-winston": "2.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
