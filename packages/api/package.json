{
  "name": "@binder/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-localization-catalogs.mjs",
    "test": "pnpm build && vitest run",
    "coverage": "pnpm build && vitest run --coverage",
    "dev": "dotenv run -f ../../.env -- node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:debug": "dotenv run -f ../../.env -- nest start --debug --watch"
  },
  "dependencies": {
    "@binder/common": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/sequelize": "12.0.0",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/throttler": "6.7.1",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "mupdf": "1.28.1",
    "nest-winston": "2.0.0",
    "nodemailer": "10.0.14",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
