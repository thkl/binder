{
  "name": "@binder/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "coverage": "pnpm build && vitest run --coverage",
    "dev": "dotenv run -f ../../.env -- node --watch dist/main.js",
    "start": "pnpm build && dotenv run -f ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@binder/common": "workspace:*",
    "age-encryption": "0.3.1",
    "dotenv": "18.0.8",
    "imapflow": "2.2.6",
    "mailparser": "3.9.36",
    "mupdf": "1.28.1",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
