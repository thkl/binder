NODE_ENV=development

# API
API_PORT=3000
API_PREFIX=api/v1
CLIENT_PATH=packages/client/dist/client

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=binder
DATABASE_USER=binder
DATABASE_PASSWORD=binder
DATABASE_LOGGING=false

# Filesystem document storage
DOCUMENT_STORAGE_ROOT=./storage
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,txt
DOCUMENT_KEEP_DERIVED_FILES=true
DOCUMENT_IMPORT_OWNER_ID=
DOCUMENT_MALWARE_SCAN_REQUIRED=false

# Authentication
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_TTL_MS=86400000
INITIAL_ADMIN_USERNAME=admin
LOCAL_JWT_ENABLED=false

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
LOG_CONSOLE=true
LOG_JSON=false
