NODE_ENV=development

# API
API_PORT=3000
BINDER_HOST_PORT=3000
API_PREFIX=api/v1
ROOT_URI=http://localhost:3000
APP_ROOT_PATH=../..
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Leave empty for a Docker-managed volume, or set an absolute host/NAS path.
# BINDER_DOCUMENTS_PATH=/mnt/documents

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=binder
DATABASE_USER=binder
DATABASE_PASSWORD=replace-with-a-long-random-database-password
DATABASE_AUTOMIGRATE=true
DATABASE_LOGGING=false

# Optional executable override; the backup destination is configured in the database
PG_DUMP_PATH=pg_dump

# Optional Dropbox OAuth application used by encrypted external backups.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Alternatively, use Docker/Kubernetes secret files. *_FILE takes precedence
# when the corresponding direct value is empty.
# DROPBOX_APP_KEY_FILE=/run/secrets/api_dropbox_app_key
# DROPBOX_APP_SECRET_FILE=/run/secrets/api_dropbox_app_secret

# Filesystem document storage

# Authentication
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_TTL_MS=86400000

# Set to false to disable the MCP plugin, its bearer-token endpoints, and /mcp.
MCP_ENABLED=true
SETUP_SECRET=replace-with-a-long-random-first-run-setup-secret
LOCAL_JWT_ENABLED=false

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
LOG_CONSOLE=true
LOG_JSON=false
