NODE_ENV=development

# API
API_PORT=3000
API_PREFIX=api/v1
APP_ROOT_PATH=../..
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=binder
DATABASE_USER=binder
DATABASE_PASSWORD=binder
DATABASE_LOGGING=false

# Backup destination (the worker must be able to write here)
BACKUP_ROOT_PATH=./backups
PG_DUMP_PATH=pg_dump

# Filesystem document storage

# Authentication
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_TTL_MS=86400000
INITIAL_ADMIN_USERNAME=admin
LOCAL_JWT_ENABLED=false

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
LOG_CONSOLE=true
LOG_JSON=false
